{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SE-Klausur-Benchmark-Frage",
  "description": "Schema einer einzelnen Benchmark-Frage inkl. Rubrik und bepunkteten Antwortvarianten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "topic", "type", "question", "max_points", "rubric", "answers"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^se-[0-9]{3}$"},
    "topic": {"type": "string"},
    "short_label": {"type": "string", "description": "Kurzbezeichnung für Tabellen/Abbildungen (optional; sonst wird topic verwendet)."},
    "type": {
      "type": "string",
      "enum": ["definition", "erklaerung", "vergleich", "anwendung", "begruendung"]
    },
    "question": {"type": "string"},
    "max_points": {"type": "integer", "minimum": 1},
    "source_note": {"type": "string", "description": "Herkunft/Orientierung der Frage (Quelle, Lehrbuch, Anlehnung)."},
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "points"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "criterion": {"type": "string"},
          "points": {"type": "number", "minimum": 0}
        }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answer_id", "points", "level", "variant", "operation", "text"],
        "properties": {
          "answer_id": {"type": "string"},
          "points": {"type": "number", "minimum": 0, "description": "Ground-Truth-Punktzahl dieser Antwort."},
          "level": {"type": "string", "enum": ["null", "teil", "voll"]},
          "variant": {"type": "string", "description": "z.B. base, paraphrase-1, reorder-1."},
          "operation": {
            "type": "string",
            "enum": ["base", "paraphrase", "reorder", "partial_reformulation", "llm_augmented"]
          },
          "text": {"type": "string"},
          "rubric_fulfilled": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "IDs der erfüllten Rubrik-Kriterien (Begründung der Punktzahl)."
          }
        }
      }
    }
  }
}
