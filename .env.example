# Vorlage für lokale Geheimnisse.
# Kopiere diese Datei nach ".env" (gleicher Ordner) und trage einen GÜLTIGEN
# API-Key ein. Die Datei ".env" steht in .gitignore und wird NICHT committet.
#
#   cp .env.example .env        # bzw. unter Windows: Copy-Item .env.example .env
#
# --- Betrieb über OpenRouter (Default, OpenAI-kompatibel) ---
# Modelle in config.json: z-ai/glm-5.2 (main), mistralai/mistral-small-2603 (sensitivity),
# openai/gpt-oss-120b (tertiary, nur Ensemble).
OPENROUTER_API_KEY=sk-or-v1-DEIN-GUELTIGER-KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Alternativ: direkter OpenAI-Betrieb ---
# Wird nur genutzt, wenn OPENROUTER_API_KEY nicht gesetzt ist und in config.json
# OpenAI-Modellnamen (z.B. gpt-4.1-2025-04-14) stehen.
# OPENAI_API_KEY=sk-DEIN-GUELTIGER-KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
